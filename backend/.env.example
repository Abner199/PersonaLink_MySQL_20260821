# 复制为 backend/.env 后填写真实值；.env 绝不可提交 Git。
NODE_ENV=development
PORT=3003

# 本机 MySQL、Docker MySQL 或云数据库连接信息
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=personalink
DB_USER=personalink
DB_PASSWORD=请替换为强密码
DB_CONNECTION_LIMIT=10

# 仅在 npm run db:schema 建库建表时需要；应用运行不使用它。
# DB_ADMIN_USER=root
# DB_ADMIN_PASSWORD=请用一次性环境变量或安全密钥管理服务提供

# 仅用于把旧 JSON 管理员账号迁入 MySQL。上线后应改为独立强密码。
ADMIN_INITIAL_PASSWORD=admin123
